{
  "databaseChangeLog": [
    {
      "changeSet": {
        "id": 1,
        "author": "Omar Sartini",
        "comment": "Create Patron, Book, Book Instance y Loan tables",
        "changes": [
          {
            "createTable": {
              "tableName": "patron",
              "columns": [
                {
                  "column": {
                    "name": "id",
                    "type": "uuid",
                    "constraints": {
                      "primaryKey": true
                    }
                  }
                },
                {
                  "column": {
                    "name": "type",
                    "type": "integer",
                    "constraints": {
                      "nullable": false
                    }
                  }
                },
                {
                  "column": {
                    "name": "name",
                    "type": "varchar(100)",
                    "constraints": {
                      "nullable": false
                    }
                  }
                },
                {
                  "column": {
                    "name": "email",
                    "type": "varchar(100)",
                    "constraints": {
                      "nullable": false
                    }
                  }
                }
              ]
            }
          },
          {
            "createTable": {
              "tableName": "book",
              "columns": [
                {
                  "column": {
                    "name": "id",
                    "type": "uuid",
                    "constraints": {
                      "primaryKey": true
                    }
                  }
                },
                {
                  "column": {
                    "name": "title",
                    "type": "varchar(100)",
                    "constraints": {
                      "nullable": false
                    }
                  }
                },
                {
                  "column": {
                    "name": "author",
                    "type": "varchar(100)",
                    "constraints": {
                      "nullable": false
                    }
                  }
                },
                {
                  "column": {
                    "name": "isbn",
                    "type": "varchar(100)",
                    "constraints": {
                      "nullable": false
                    }
                  }
                }
              ]
            }
          },
          {
            "createTable": {
              "tableName": "book_instance",
              "columns": [
                {
                  "column": {
                    "name": "id",
                    "type": "uuid",
                    "constraints": {
                      "primaryKey": true
                    }
                  }
                },
                {
                  "column": {
                    "name": "book_id",
                    "type": "uuid",
                    "constraints": {
                      "foreignKeyName": "fk_book_instance_book",
                      "references": "book(id)"
                    }
                  }
                },
                {
                  "column": {
                    "name": "type",
                    "type": "integer",
                    "constraints": {
                      "nullable": false
                    }
                  }
                },
                {
                  "column": {
                    "name": "status",
                    "type": "integer",
                    "constraints": {
                      "nullable": false
                    }
                  }
                },
                {
                  "column": {
                    "name": "version",
                    "type": "BIGINT"
                  }
                }
              ]
            }
          },
          {
            "createTable": {
              "tableName": "loan",
              "columns": [
                {
                  "column": {
                    "name": "id",
                    "type": "uuid",
                    "constraints": {
                      "primaryKey": true
                    }
                  }
                },
                {
                  "column": {
                    "name": "patron_id",
                    "type": "uuid",
                    "constraints": {
                      "foreignKeyName": "fk_loan_patron",
                      "references": "patron(id)"
                    }
                  }
                },
                {
                  "column": {
                    "name": "book_instance_id",
                    "type": "uuid",
                    "constraints": {
                      "foreignKeyName": "fk_loan_book_instance",
                      "references": "book_instance(id)"
                    }
                  }
                },
                {
                  "column": {
                    "name": "status",
                    "type": "integer",
                    "constraints": {
                      "nullable": false
                    }
                  }
                },
                {
                  "column": {
                    "name": "reserved_at",
                    "type": "timestamp"
                  }
                },
                {
                  "column": {
                    "name": "lent_at",
                    "type": "timestamp"
                  }
                },
                {
                  "column": {
                    "name": "due_at",
                    "type": "timestamp"
                  }
                },
                {
                  "column": {
                    "name": "returned_at",
                    "type": "timestamp"
                  }
                }
              ]
            }
          }
        ]
      }
    }
  ]
}